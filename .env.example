# Copy this file to .env and fill in real values before running the project.

# Optional: get a free key at https://www.geoapify.com/ to enable
# reverse-geocoding ("Detect Location" button on the report form).
# If left blank, the app still works — citizens just type the address manually.
GEOAPIFY_API_KEY=

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Leave the POSTGRES_* variables UNSET to use local SQLite automatically
# (recommended for a quick demo/viva). Fill them in only if you have a
# Postgres server running and want to use it instead.
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
