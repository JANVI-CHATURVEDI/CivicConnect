# Copy this file to .env and fill in real values before running the project.

# Optional: get a free key at https://www.geoapify.com/ to enable
# reverse-geocoding ("Detect Location" button on the report form).
# If left blank, the app still works — citizens just type the address manually.
GEOAPIFY_API_KEY=

# Optional: get a free key at https://aistudio.google.com/apikey to enable
# real Gemini-based AI triage (category/priority/department). Falls back
# to the built-in rule engine automatically if left blank or unreachable.
GEMINI_API_KEY=

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Leave everything below UNSET to use local SQLite automatically
# (recommended for a quick demo/viva).

# Option 1: a single connection string (what Neon, Railway, Render, etc.
# give you by default). Takes priority if set.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option 2: individual Postgres variables (used only if DATABASE_URL is unset).
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
