# Copy to .env
# Location uses free OpenStreetMap Nominatim (no key). Geoapify is only a fallback.
GEOAPIFY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=12
AI_SUGGEST_RATE_LIMIT=30/h
API_THROTTLE_USER=300/hour
API_THROTTLE_ANON=60/hour
DJANGO_SECRET_KEY=change-this-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SENTRY_DSN=
LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
